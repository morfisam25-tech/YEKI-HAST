# Runtime must be explicit. DEV_EXPOSE_OTP only works when NODE_ENV=development.
NODE_ENV=development

# Explicit environment identity for apps/web and apps/admin's server-side API proxy
# (apps/*/app/api/_env.ts). NEVER derived from NODE_ENV alone: Vercel builds Preview
# deployments with NODE_ENV=production too, so a NODE_ENV-only check cannot tell a real
# Preview Internal Beta deployment apart from Production. Leave unset to derive identity
# from the platform-provided VERCEL_ENV (production|preview|development) instead; set
# explicitly only to pin identity where VERCEL_ENV is unavailable (e.g. local scripts).
# One of: production | preview_internal_beta | local. Any other value fails closed.
APP_ENV=

# Core database
# Remote PostgreSQL URLs are normalized by the DB client to sslmode=verify-full.
DATABASE_URL=
DB_POOL_MAX=10

# Separate Web/Admin Vercel projects proxy server-side to the API deployment.
# Controlled production is source-locked to the canonical yeki-hast-unique-6ff0.vercel.app
# API alias regardless of these values. In preview_internal_beta (see APP_ENV above) these
# ARE REQUIRED and must point at the isolated Preview API deployment, never at the
# production alias above; a missing or Production-pointing value fails closed instead of
# falling back to Production. Elsewhere (local) these are optional local/dev overrides.
WEB_API_BASE_URL=
ADMIN_API_BASE_URL=

# Public-release policy/support surfaces.
# Controlled production env sync locks Privacy, Terms and Account Deletion to the
# checked-in first-party Web pages and support to the selected Workspace mailbox.
# Real mailbox delivery/readback must still pass the production Gmail API E2E gate.
# Runtime values remain explicit here for local/other environments.
PRIVACY_POLICY_URL=
TERMS_OF_SERVICE_URL=
ACCOUNT_DELETION_URL=
CHILD_SAFETY_URL=
SUPPORT_EMAIL=

# Private-data encryption key ring. Each value is a 32-byte base64 AES-256 key.
# Example shape only; never commit real keys.
ACTIVE_DATA_ENCRYPTION_KEY_ID=k1
DATA_ENCRYPTION_KEYS={"k1":""}
PHONE_HASH_PEPPER=
EMAIL_HASH_PEPPER=
IP_HASH_PEPPER=
OTP_HASH_PEPPER=
KYC_HASH_PEPPER=

# API session / OTP
SESSION_TTL_HOURS=720
OTP_TTL_SECONDS=300
OTP_PHONE_LIMIT_PER_15M=5
OTP_EMAIL_LIMIT_PER_15M=5
# Browser email auth is server-proxied on Vercel, so its IP bucket is intentionally
# separate from the stricter direct phone/SMS OTP IP bucket below.
OTP_EMAIL_IP_LIMIT_PER_15M=200
OTP_IP_LIMIT_PER_15M=20
OTP_GLOBAL_LIMIT_PER_15M=1000

# One-time first-admin bootstrap. Leave disabled by default.
# When enabled, exactly one configured verified phone/email may become the first admin,
# and BOOTSTRAP_ADMIN_EXPIRES_AT must be a future ISO timestamp no more than 30 minutes away.
# The flow refuses to bootstrap when any admin exists or a prior bootstrap audit record exists.
# Disable/remove all bootstrap values immediately after the first successful admin login.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_PHONE_E164=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_EXPIRES_AT=

# Primary beta login: email OTP. Local development uses EMAIL_PROVIDER=dev.
# Controlled production is source-locked to the Google Workspace mailbox
# sales@uniqueholding.com.tr and uses Gmail API with a domain-wide-delegated service account.
# Never commit a real service-account JSON credential.
EMAIL_PROVIDER=dev
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_IMPERSONATED_USER=sales@uniqueholding.com.tr
GMAIL_FROM_EMAIL=sales@uniqueholding.com.tr
GMAIL_FROM_NAME=Yeki Hast

# Closed-beta call phone verification can be performed manually by an authenticated admin
# after an out-of-band ownership check. Keep false for public launch.
MANUAL_PHONE_VERIFICATION_BETA_ENABLED=false

# SMS OTP remains an optional fallback / future automated phone-verification channel.
# Production SMS providers: SMS.ir Verify, Kavenegar Verify/Lookup, or IPPanel Pattern API.
# Local development may use SMS_PROVIDER=dev; production rejects the dev provider.
SMS_PROVIDER=dev
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAMETER_NAME=CODE
# Set true in production only after the SMS.ir panel shows the Verify template as approved.
SMSIR_OTP_TEMPLATE_APPROVED=false
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
IPPANEL_API_KEY=
IPPANEL_PATTERN_CODE=
IPPANEL_FROM_NUMBER=
DEV_EXPOSE_OTP=false

# Caller wallet top-ups. Production remains fail-closed until a real NextPay API key and
# the final HTTPS API callback origin are configured.
PAYMENT_PROVIDER=
NEXTPAY_API_KEY=
PAYMENT_CALLBACK_BASE_URL=

# Listener KYC inquiries. NEXTPAY_INQUIRY_API is the separate inquiry-service UUID from NextPay.
# The current adapter sends documented SabtAhval/Shahkar/Sheba requests only; it does not grant KYC verification.
KYC_INQUIRY_PROVIDER=
NEXTPAY_INQUIRY_API=

# Listener payouts. Keep unset until NextPay payout web service is explicitly enabled for the account.
PAYOUT_PROVIDER=
NEXTPAY_PAYOUT_WID=
NEXTPAY_PAYOUT_AUTH=

# Call transport (Blueprint v1.2).
# Internet Voice is primary. Masked PSTN is optional fallback and must not block launch.
CALL_PRIMARY_TRANSPORT=internet_voice
CALL_FALLBACK_TRANSPORT=masked_pstn
# Preferred production TURN mode: keep the long-lived Cloudflare TURN key/token server-side.
# The API exchanges them for short-lived RTCIceServer credentials and returns only those
# temporary credentials to authenticated call participants. Never commit real values.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Cloudflare accepts up to 48 hours. Four hours safely covers the current call caps/extensions.
CLOUDFLARE_TURN_TTL_SECONDS=14400
# Static RTCIceServer JSON remains available for local testing or another TURN provider.
# Production Internet Voice fails closed unless Cloudflare is fully configured or at least
# one TURN/TURNS relay exists here. Do not commit real relay credentials.
# Example: [{"urls":"turn:turn.example.com:3478","username":"...","credential":"..."}]
INTERNET_VOICE_ICE_SERVERS_JSON=
# Iran-to-Iran survival path is a separate domestic control/media configuration. It is
# reported as not configured until both domestic TURN and HTTPS control-plane values exist.
INTERNET_VOICE_IRAN_ICE_SERVERS_JSON=
INTERNET_VOICE_IRAN_CONTROL_PLANE_BASE_URL=

# Masked PSTN fallback. Only dev is implemented locally right now; production rejects it.
TELEPHONY_PROVIDER=dev

# Call recording (W58 foundation). PLATFORM CALL RECORDING = ON AT PUBLIC LAUNCH
# is locked product policy: production accepts only an explicit
# CALL_RECORDING_REQUIRED=true with a fully configured provider + consent
# policy version; a missing/incomplete value fails closed (new calls refuse to
# be created rather than silently running unrecorded). Internal Preview may
# set CALL_RECORDING_REQUIRED=false as an explicit pre-W54/W60 technical-beta
# exception -- omitting the flag entirely is NOT the same as false and also
# fails closed. See packages/domain/src/recording.ts resolveRecordingRequirement.
CALL_RECORDING_REQUIRED=false
CALL_RECORDING_PROVIDER=cloudflare_realtimekit
CALL_RECORDING_CONSENT_POLICY_VERSION=
# Cloudflare RealtimeKit (developers.cloudflare.com/realtime/realtimekit/).
# Secrets stay server-side; the API only ever returns grant/status metadata,
# never these values, to any client.
CLOUDFLARE_REALTIMEKIT_ACCOUNT_ID=
CLOUDFLARE_REALTIMEKIT_APP_ID=
CLOUDFLARE_REALTIMEKIT_API_TOKEN=
# Operational defaults -- PRODUCT POLICY, not a legal/statutory mandate. See
# docs/W58_RECORDING_CORE_FOUNDATION.md "Retention" for how to change these.
CALL_RECORDING_RETENTION_DAYS=90
CALL_RECORDING_PLAYBACK_TTL_SECONDS=300
CALL_RECORDING_CONFIRMATION_TIMEOUT_SECONDS=45

# W60 mobile media transport. Production accepts only an explicit
# CALL_MEDIA_PROVIDER=realtimekit (the legacy react-native-webrtc/custom
# offer-answer/ICE-polling path cannot feed RealtimeKit-side recording, and
# Production always requires recording -- see docs/
# W60_REALTIMEKIT_MOBILE_MEDIA_MIGRATION.md). Internal Preview may
# explicitly set legacy_p2p while live RealtimeKit credentials are not yet
# available; omitting this entirely fails closed on both. See
# packages/domain/src/call-media.ts resolveCallMediaProvider.
CALL_MEDIA_PROVIDER=legacy_p2p
# The Cloudflare RealtimeKit Preset (meeting type "Voice") every call
# participant joins under -- enforces audio-only (no camera/video) on
# Cloudflare's side. Created in the Cloudflare dashboard/account, not by this
# codebase. Required whenever CALL_MEDIA_PROVIDER=realtimekit.
CLOUDFLARE_REALTIMEKIT_VOICE_PRESET_NAME=

# Caller-facing marketplace/call routes stay closed until every caller launch dependency is ready.
CALLER_CLOSED_BETA_ENABLED=false
# Production Caller also requires an explicit hosting-commercial-use approval. Keep false until
# the actual production hosting plan/terms have been checked and an eligible plan is active.
COMMERCIAL_HOSTING_APPROVED=false

# Public Caller is 18+ only. A blank or non-18 value fails closed; version changes require fresh consent.
CALLER_MINIMUM_AGE=18
CALLER_AGE_POLICY_VERSION=age-18-2026-09-13

# Product defaults (Iran beta only; backend remains market-aware)
DEFAULT_PRODUCT_CODE=yeki_hast
DEFAULT_SERVICE_CODE=human_listening
DEFAULT_MARKET_CODE=ir

PORT=4000
