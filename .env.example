# Runtime must be explicit. DEV_EXPOSE_OTP only works when NODE_ENV=development.
NODE_ENV=development

# Core database
# Remote PostgreSQL URLs are normalized by the DB client to sslmode=verify-full.
DATABASE_URL=
DB_POOL_MAX=10

# Separate Web/Admin Vercel projects proxy server-side to the API deployment.
# In production set these to the final HTTPS API origin; never rely on another account's default domain.
WEB_API_BASE_URL=
ADMIN_API_BASE_URL=

# Private-data encryption key ring. Each value is a 32-byte base64 AES-256 key.
# Example shape only; never commit real keys.
ACTIVE_DATA_ENCRYPTION_KEY_ID=k1
DATA_ENCRYPTION_KEYS={"k1":""}
PHONE_HASH_PEPPER=
EMAIL_HASH_PEPPER=
IP_HASH_PEPPER=
OTP_HASH_PEPPER=
KYC_HASH_PEPPER=

# API session / OTP
SESSION_TTL_HOURS=720
OTP_TTL_SECONDS=300
OTP_PHONE_LIMIT_PER_15M=5
OTP_EMAIL_LIMIT_PER_15M=5
OTP_IP_LIMIT_PER_15M=20
OTP_GLOBAL_LIMIT_PER_15M=1000

# One-time first-admin bootstrap. Leave disabled by default.
# When enabled, either the configured verified phone or verified email may become the first admin.
# The flow refuses to bootstrap when any admin exists or a prior bootstrap audit record exists.
# Disable/remove these values immediately after the first successful admin login.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_PHONE_E164=
BOOTSTRAP_ADMIN_EMAIL=

# Primary beta login: email OTP over a normal authenticated SMTP mailbox.
# Production rejects the dev provider. SMTP_SECURE=true is typical for port 465;
# SMTP_SECURE=false uses STARTTLS and is typical for port 587.
EMAIL_PROVIDER=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Yeki Hast

# Closed-beta call phone verification can be performed manually by an authenticated admin
# after an out-of-band ownership check. Keep false for public launch.
MANUAL_PHONE_VERIFICATION_BETA_ENABLED=false

# SMS OTP remains an optional fallback / future automated phone-verification channel.
# Production SMS providers: SMS.ir Verify, Kavenegar Verify/Lookup, or IPPanel Pattern API.
# Local development may use SMS_PROVIDER=dev; production rejects the dev provider.
SMS_PROVIDER=dev
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAMETER_NAME=CODE
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
IPPANEL_API_KEY=
IPPANEL_PATTERN_CODE=
IPPANEL_FROM_NUMBER=
DEV_EXPOSE_OTP=false

# Caller wallet top-ups. Production remains fail-closed until a real NextPay API key and
# the final HTTPS API callback origin are configured.
PAYMENT_PROVIDER=
NEXTPAY_API_KEY=
PAYMENT_CALLBACK_BASE_URL=

# Listener KYC inquiries. NEXTPAY_INQUIRY_API is the separate inquiry-service UUID from NextPay.
# The current adapter sends documented SabtAhval/Shahkar/Sheba requests only; it does not grant KYC verification.
KYC_INQUIRY_PROVIDER=
NEXTPAY_INQUIRY_API=

# Listener payouts. Keep unset until NextPay payout web service is explicitly enabled for the account.
PAYOUT_PROVIDER=
NEXTPAY_PAYOUT_WID=
NEXTPAY_PAYOUT_AUTH=

# Voice bridge. Only dev is implemented locally right now; production rejects it.
TELEPHONY_PROVIDER=dev

# Caller age policy intentionally fails closed until these values are formally locked.
CALLER_MINIMUM_AGE=
CALLER_AGE_POLICY_VERSION=

# Product defaults (Iran beta only; backend remains market-aware)
DEFAULT_PRODUCT_CODE=yeki_hast
DEFAULT_SERVICE_CODE=human_listening
DEFAULT_MARKET_CODE=ir

PORT=4000