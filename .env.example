# Runtime must be explicit. DEV_EXPOSE_OTP only works when NODE_ENV=development.
NODE_ENV=development

# Core database
# Remote PostgreSQL URLs are normalized by the DB client to sslmode=verify-full.
DATABASE_URL=
DB_POOL_MAX=10

# Private-data encryption key ring. Each value is a 32-byte base64 AES-256 key.
# Example shape only; never commit real keys.
ACTIVE_DATA_ENCRYPTION_KEY_ID=k1
DATA_ENCRYPTION_KEYS={"k1":""}
PHONE_HASH_PEPPER=
IP_HASH_PEPPER=
OTP_HASH_PEPPER=

# API session / OTP
SESSION_TTL_HOURS=720
OTP_TTL_SECONDS=300
OTP_PHONE_LIMIT_PER_15M=5
OTP_IP_LIMIT_PER_15M=20
OTP_GLOBAL_LIMIT_PER_15M=1000
CALLER_MINIMUM_AGE=
CALLER_AGE_POLICY_VERSION=
SMS_PROVIDER=dev
DEV_EXPOSE_OTP=false

# Product defaults (Iran beta only; backend remains market-aware)
DEFAULT_PRODUCT_CODE=yeki_hast
DEFAULT_SERVICE_CODE=human_listening
DEFAULT_MARKET_CODE=ir

PORT=4000
