{
  "expo": {
    "name": "یکی هست",
    "slug": "yeki-hast",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "android": {
      "package": "app.yekihast.mobile",
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "app.yekihast.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    }
  }
}
