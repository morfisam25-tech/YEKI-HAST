{
  "expo": {
    "name": "یکی هست",
    "slug": "yeki-hast",
    "owner": "saimorfis-team",
    "version": "1.0.0",
    "scheme": "yekihast",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "android": {
      "package": "app.yekihast.mobile",
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "app.yekihast.mobile",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "58b9f62d-db82-421a-ad59-edccac70c316"
      }
    }
  }
}
