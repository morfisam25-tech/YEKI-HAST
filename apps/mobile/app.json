{
  "expo": {
    "name": "یکی هست",
    "slug": "yeki-hast",
    "owner": "saimorfis-team",
    "version": "1.0.0",
    "scheme": "yekihast",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/generated/app-icon.png",
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "android": {
      "package": "app.yekihast.mobile",
      "allowBackup": false,
      "icon": "./assets/generated/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/generated/android-adaptive-foreground.png",
        "monochromeImage": "./assets/generated/android-monochrome.png",
        "backgroundColor": "#0B0B0B"
      }
    },
    "ios": {
      "bundleIdentifier": "app.yekihast.mobile",
      "supportsTablet": false,
      "icon": "./assets/generated/app-icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "58b9f62d-db82-421a-ad59-edccac70c316"
      }
    }
  }
}
