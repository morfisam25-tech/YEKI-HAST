{
  "name": "yeki-hast",
  "private": true,
  "version": "0.0.8",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace @yeki-hast/mobile run start",
    "web": "npm --workspace @yeki-hast/web run dev",
    "admin": "npm --workspace @yeki-hast/admin run dev",
    "api": "npm --workspace @yeki-hast/api run dev",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm --workspace @yeki-hast/db run migrate",
    "db:check": "npm --workspace @yeki-hast/db run check",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "validate:foundation": "node scripts/validate-foundation.mjs",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run db:migrate && node scripts/verify-production-db.mjs; else echo \"Skipping DB migration for $VERCEL_ENV\"; fi"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module"
}
