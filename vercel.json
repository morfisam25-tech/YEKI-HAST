{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "iad1"
  ],
  "git": {
    "deploymentEnabled": {
      "w89/final-integrated-rc-20260922": true
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/ready",
      "destination": "/api/index"
    },
    {
      "source": "/v1/bootstrap",
      "destination": "/api/index"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/runtime"
    }
  ]
}
